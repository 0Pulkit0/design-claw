{
  "manifest_version": 3,
  "name": "Design Claw",
  "version": "0.4.0",
  "description": "A reference studio: capture visual inspiration and measured styles, save collections, and export an intentional design and build kit.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Design Claw",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
